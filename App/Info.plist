<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>YunAudioApp</string>
	<key>CFBundleIdentifier</key>
	<string>com.yuhuanstudio.yunaudio</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleIconFile</key>
	<string>YunAudio</string>
	<key>CFBundleName</key>
	<string>YunAudio</string>
	<key>CFBundleDisplayName</key>
	<string>YunAudio</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.3</string>
	<key>CFBundleVersion</key>
	<string>4</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>

	<!-- Accessory application: menu bar only, no Dock icon, no main window. -->
	<key>LSUIElement</key>
	<true/>

	<key>NSMicrophoneUsageDescription</key>
	<string>YunAudio reads your microphone so it can forward the signal to its virtual audio device.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>YunAudio can capture audio from other applications so it can be mixed into a route.</string>

	<key>NSHumanReadableCopyright</key>
	<string>YuhuanStudio</string>
	<!-- Reading what Music or Spotify is playing, for the lyrics panel. macOS
	     will not deliver the Apple event without this string, and refuses
	     silently: the panel would simply never find a track. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>YunAudio asks Music and Spotify what is playing, so it can show the words in time with it.</string>
	<!-- Remote control. A URL is understood by Shortcuts, Stream Deck,
	     AppleScript and `open` from a terminal, none of which need this
	     application to have been built by Xcode. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.yuhuanstudio.yunaudio.command</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>yunaudio</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
